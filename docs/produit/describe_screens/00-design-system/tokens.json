  "type": {
    "fontFamily": "Roboto",
    "hero": {
      "size": 48,
      "line": 56,
      "weight": 700,
      "role": "Le chiffre du jour, un seul par écran"
    },
    "amountInput": {
      "size": 36,
      "line": 44,
      "weight": 500,
      "role": "Montant en cours de saisie, chiffres tabulaires"
    },
    "title": {
      "size": 24,
      "line": 32,
      "weight": 500,
      "role": "Question ou titre d'écran dans le contenu"
    },
    "appbar": {
      "size": 22,
      "line": 28,
      "weight": 500,
      "role": "Titre de la barre du haut"
    },
    "subtitle": {
      "size": 18,
      "line": 24,
      "weight": 500,
      "role": "Titre de bloc, nom d'une feuille, unité du chiffre du jour"
    },
    "bodyLarge": {
      "size": 16,
      "line": 24,
      "weight": 400,
      "role": "Texte courant, valeur d'un champ compact"
    },
    "bodyStrong": {
      "size": 16,
      "line": 24,
      "weight": 500,
      "role": "Titre d'une ligne ou d'une carte"
    },
    "button": {
      "size": 16,
      "line": 24,
      "weight": 500,
      "role": "Libellé du bouton principal"
    },
    "body": {
      "size": 14,
      "line": 20,
      "weight": 400,
      "role": "Aides, descriptions, bulles"
    },
    "bodyMedium": {
      "size": 14,
      "line": 20,
      "weight": 500,
      "role": "Boutons texte, puces, libellés de champ"
    },
    "caption": {
      "size": 12,
      "line": 16,
      "weight": 400,
      "role": "Axes, compteur, mentions"
    },
    "captionMedium": {
      "size": 12,
      "line": 16,
      "weight": 500,
      "role": "Onglets, marques courtes"
    }
  },
  "space": {
    "s1": 4,
    "s2": 8,
    "s3": 12,
    "s4": 16,
    "s5": 24,
    "s6": 32,
    "s7": 48
  },
  "size": {
    "frameWidth": 360,
    "frameHeight": 800,
    "statusBar": 24,
    "navBar": 48,
    "gutterOnboarding": 24,
    "gutterList": 16,
    "gutterCompact": 16,
    "touchMin": 48,
    "appBar": 56,
    "bottomNav": 72,
    "button": 48,
    "chip": 32,
    "rowOne": 56,

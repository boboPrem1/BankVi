{
  "meta": {
    "name": "BankVi Design System",
    "version": "0.4",
    "date": "2026-11-07",
    "units": "dp pour les dimensions, sp pour le texte, ms pour les durées",
    "note": "Valeurs de référence du style WhatsApp pour Android, relevées par des tiers et adaptées pour l'accessibilité. WhatsApp ne publie aucune palette officielle de son interface."
  },
  "color": {
    "bg": {
      "canvas": {
        "light": "#FFFFFF",
        "dark": "#0B141A",
        "role": "Fond de tous les écrans"
      },
      "subtle": {
        "light": "#F0F2F5",
        "dark": "#111B21",
        "role": "Zones groupées, champ de recherche"
      },
      "elevated": {
        "light": "#FFFFFF",
        "dark": "#202C33",
        "role": "Cartes, feuilles basses, dialogues"
      },
      "bubbleApp": {
        "light": "#F0F2F5",
        "dark": "#202C33",
        "role": "Bulle : l'app explique quelque chose"
      },
      "bubbleUser": {
        "light": "#D9FDD3",
        "dark": "#005C4B",
        "role": "Bulle sortante : dépense notée, réponse de l'utilisateur"
      },
      "bubbleIncome": {
        "light": "#F0F2F5",
        "dark": "#202C33",
        "role": "Bulle entrante : revenu noté"
      },
      "selected": {
        "light": "#D8FDD2",
        "dark": "#103529",
        "role": "Puce, carte ou onglet sélectionnés"
      },
      "scrim": {
        "light": "rgba(11,20,26,0.40)",
        "dark": "rgba(0,0,0,0.60)",
        "role": "Voile derrière une feuille ou un dialogue"
      }
    },
    "text": {
      "primary": {
        "light": "#111B21",
        "dark": "#E9EDEF",
        "role": "Titres, montants, texte courant"
      },
      "secondary": {
        "light": "#54656F",
        "dark": "#AEBAC1",
        "role": "Aides, descriptions"
      },
      "tertiary": {
        "light": "#667781",
        "dark": "#8696A0",
        "role": "Axes, placeholders. En clair : sur fond blanc uniquement"
      },
      "disabled": {
        "light": "#667781",
        "dark": "#8696A0",
        "role": "Libellé d'un bouton désactivé"
      },
      "link": {
        "light": "#00735E",
        "dark": "#25D366",
        "role": "Boutons texte, liens, marque écrite"
      },
      "onAction": {
        "light": "#0B141A",
        "dark": "#0B141A",
        "role": "Texte et icône sur le vert d'action"
      },
      "onSelected": {
        "light": "#0A3D2E",
        "dark": "#D9FDD3",
        "role": "Texte sur fond sélectionné"
      }
    },
    "action": {
      "primary": {
        "light": "#25D366",
        "dark": "#25D366",
        "role": "Bouton principal"
      },
      "primaryPressed": {
        "light": "#1FAD56",
        "dark": "#1FAD56",
        "role": "Bouton principal, état appuyé"
      },
      "disabled": {
        "light": "#E9EDEF",
        "dark": "#202C33",
        "role": "Fond d'un bouton désactivé"
      },
      "ripple": {
        "light": "rgba(17,27,33,0.10)",
        "dark": "rgba(233,237,239,0.12)",
        "role": "Retour tactile sur une surface"
      }
    },
    "border": {
      "subtle": {
        "light": "#E9EDEF",
        "dark": "#2A3942",
        "role": "Séparateurs, contour de carte"
      },
      "control": {
        "light": "#7A8A94",
        "dark": "#667781",
        "role": "Soulignement de champ, contour de puce et de radio"
      },
      "focus": {
        "light": "#008069",
        "dark": "#25D366",
        "role": "Champ actif, carte sélectionnée"
      }
    },
    "status": {
      "warnFg": {
        "light": "#8A4B00",
        "dark": "#FFD27A",
        "role": "Argent manquant, attention"
      },
      "warnBg": {
        "light": "#FFF3D6",
        "dark": "#3A2C10",
        "role": "Fond de l'attention"
      },
      "errorFg": {
        "light": "#B3261E",
        "dark": "#F2B8B5",
        "role": "Erreur de saisie, action destructive"
      },
      "errorBg": {
        "light": "#FBE9E7",
        "dark": "#3C1F1E",
        "role": "Fond d'une erreur"
      },
      "infoFg": {
        "light": "#0B5CAD",
        "dark": "#A8D4FF",
        "role": "Information neutre, marque « Exemple »"
      },
      "infoBg": {
        "light": "#E3F0FB",
        "dark": "#10283F",
        "role": "Fond de l'information"
      },
      "successFg": {
        "light": "#00735E",
        "dark": "#25D366",
        "role": "Confirmation, en texte et icône"
      }
    },
    "chart": {
      "line": {
        "light": "#008069",
        "dark": "#25D366",
        "role": "Courbe de l'horizon"
      },
      "area": {
        "light": "rgba(0,128,105,0.10)",
        "dark": "rgba(37,211,102,0.10)",
        "role": "Lavis sous la courbe"
      },
      "grid": {
        "light": "#E9EDEF",
        "dark": "#2A3942",
        "role": "Lignes de repère"
      },
      "zero": {
        "light": "#7A8A94",
        "dark": "#667781",
        "role": "Ligne du zéro"
      },
      "lack": {
        "light": "rgba(138,75,0,0.12)",
        "dark": "rgba(255,210,122,0.14)",
        "role": "Lavis de la zone sous zéro"
      }
    },
    "pot": {
      "1": {
        "light": "#008069",
        "dark": "#00A884",
        "role": "Premier pot d'une recette"
      },
      "2": {
        "light": "#D97A00",
        "dark": "#C47F00",
        "role": "Deuxième pot"
      },
      "3": {
        "light": "#7F66FF",
        "dark": "#8B75FF",
        "role": "Troisième pot"
      },
      "4": {
        "light": "#E0568A",
        "dark": "#E0588A",
        "role": "Quatrième pot"
      },
      "5": {
        "light": "#027EB5",
        "dark": "#2E9BD6",
        "role": "Cinquième pot"
      },
      "6": {
        "light": "#8F7A1F",
        "dark": "#93852A",
        "role": "Sixième pot"
      }
    },
    "illustration": {
      "outline": {
        "light": "#111B21",
        "dark": "#E9EDEF",
        "role": "Contour de toutes les illustrations"
      },
      "green": {
        "light": "#25D366",
        "dark": "#25D366",
        "role": "Billet, éléments d'action"
      },
      "mint": {
        "light": "#D9FDD3",
        "dark": "#005C4B",
        "role": "Grande surface d'une illustration"
      },
      "amber": {
        "light": "#FFBC38",
        "dark": "#FFBC38",
        "role": "Pièces de monnaie"
      },
      "paper": {
        "light": "#FFFFFF",
        "dark": "#202C33",
        "role": "Surface neutre d'une illustration"
      }
    }
  },

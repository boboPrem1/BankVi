{
  "meta": {
    "name": "BankVi Design System",
    "version": "0.6",
    "date": "2026-11-13",
    "units": "dp pour les dimensions, sp pour le texte, ms pour les durées",
    "note": "Identité Terracotta & Lagune propre à BankVi, inspirée des conventions d'usage familières au Togo et calibrée pour les contrastes plein soleil WCAG 2.1."
  },
  "color": {
    "bg": {
      "canvas": {
        "light": "#FAF7F2",
        "dark": "#0D1520",
        "role": "Fond de tous les écrans (sable ivoire / bleu nuit atlantique)"
      },
      "subtle": {
        "light": "#F1ECE4",
        "dark": "#142030",
        "role": "Zones groupées, champ de recherche"
      },
      "elevated": {
        "light": "#FFFFFF",
        "dark": "#1B2A3E",
        "role": "Cartes, feuilles basses, dialogues"
      },
      "bubbleApp": {
        "light": "#F1ECE4",
        "dark": "#1B2A3E",
        "role": "Capsule : l'app explique quelque chose"
      },
      "bubbleUser": {
        "light": "#FCE8DF",
        "dark": "#4A2218",
        "role": "Capsule sortante : dépense notée, réponse de l'utilisateur"
      },
      "bubbleIncome": {
        "light": "#E4F2F7",
        "dark": "#133447",
        "role": "Capsule entrante : revenu noté"
      },
      "selected": {
        "light": "#F9DFD3",
        "dark": "#4D2318",
        "role": "Puce, carte ou onglet sélectionnés"
      },
      "scrim": {
        "light": "rgba(13,21,32,0.45)",
        "dark": "rgba(0,0,0,0.65)",
        "role": "Voile derrière une feuille ou un dialogue"
      }
    },
    "text": {
      "primary": {
        "light": "#1C1613",
        "dark": "#F5F0EB",
        "role": "Titres, montants, texte courant"
      },
      "secondary": {
        "light": "#5C514B",
        "dark": "#B8AFA8",
        "role": "Aides, descriptions"
      },
      "tertiary": {
        "light": "#6B5E57",
        "dark": "#948B84",
        "role": "Axes, placeholders. En clair : sur fond sable ou blanc uniquement"
      },
      "timeOnExpense": {
        "light": "#52362C",
        "dark": "#FAD8C8",
        "role": "Heure et libellé secondaire dans une capsule de dépense"
      },
      "disabled": {
        "light": "#6B5E57",
        "dark": "#948B84",
        "role": "Libellé d'un bouton désactivé"
      },
      "link": {
        "light": "#A6331A",
        "dark": "#FF8B6B",
        "role": "Boutons texte, liens, marque écrite"
      },
      "onAction": {
        "light": "#FFFFFF",
        "dark": "#1C120E",
        "role": "Texte et icône sur le terracotta d'action"
      },
      "onSelected": {
        "light": "#5E1D0E",
        "dark": "#FDE5DA",
        "role": "Texte sur fond sélectionné"
      }
    },
    "action": {
      "primary": {
        "light": "#B83B20",
        "dark": "#F07B5A",
        "role": "Bouton principal (terracotta de Lomé / terracotta solaire)"
      },
      "primaryPressed": {
        "light": "#962E17",
        "dark": "#D96443",
        "role": "Bouton principal, état appuyé"
      },
      "disabled": {
        "light": "#E6DFD5",
        "dark": "#1B2A3E",
        "role": "Fond d'un bouton désactivé"
      },
      "ripple": {
        "light": "rgba(28,22,19,0.10)",
        "dark": "rgba(245,240,235,0.12)",
        "role": "Retour tactile sur une surface"
      }
    },
    "border": {
      "subtle": {
        "light": "#E3DCD2",
        "dark": "#26384F",
        "role": "Séparateurs, contour de carte"
      },
      "control": {
        "light": "#7A6D65",
        "dark": "#728399",
        "role": "Soulignement de champ, contour de puce et de radio"
      },
      "focus": {
        "light": "#B83B20",
        "dark": "#FF8B6B",
        "role": "Champ actif, carte sélectionnée"
      }
    },
    "status": {
      "warnFg": {
        "light": "#8A4B00",
        "dark": "#FFD27A",
        "role": "Argent manquant, attention"
      },
      "warnBg": {
        "light": "#FFF3D6",
        "dark": "#3A2C10",
        "role": "Fond de l'attention"
      },
      "errorFg": {
        "light": "#B3261E",
        "dark": "#F2B8B5",
        "role": "Erreur de saisie, action destructive"
      },
      "errorBg": {
        "light": "#FBE9E7",
        "dark": "#3C1F1E",
        "role": "Fond d'une erreur"
      },
      "infoFg": {
        "light": "#0B5CAD",
        "dark": "#A8D4FF",
        "role": "Information neutre, marque « Exemple »"
      },
      "infoBg": {
        "light": "#E3F0FB",
        "dark": "#10283F",
        "role": "Fond de l'information"
      },
      "successFg": {
        "light": "#0D6E52",
        "dark": "#47D1A3",
        "role": "Confirmation, en texte et icône"
      }
    },
    "chart": {
      "line": {
        "light": "#0E6BA8",
        "dark": "#4DA8DA",
        "role": "Courbe de l'horizon (bleu lagune)"
      },
      "area": {
        "light": "rgba(14,107,168,0.12)",
        "dark": "rgba(77,168,218,0.14)",
        "role": "Lavis sous la courbe"
      },
      "grid": {
        "light": "#E3DCD2",
        "dark": "#26384F",
        "role": "Lignes de repère"
      },
      "zero": {
        "light": "#7A6D65",
        "dark": "#728399",
        "role": "Ligne du zéro"
      },
      "lack": {
        "light": "rgba(138,75,0,0.12)",
        "dark": "rgba(255,210,122,0.14)",
        "role": "Lavis de la zone sous zéro"
      }
    },
    "pot": {
      "1": {
        "light": "#0E6BA8",
        "dark": "#3898EC",
        "role": "Premier pot d'une recette (Lagune)"
      },
      "2": {
        "light": "#B85A00",
        "dark": "#E0862B",
        "role": "Deuxième pot (Ocre)"
      },
      "3": {
        "light": "#6B52E0",
        "dark": "#8B75FF",
        "role": "Troisième pot (Indigo)"
      },
      "4": {
        "light": "#0D7A5F",
        "dark": "#22B08C",
        "role": "Quatrième pot (Émeraude)"
      },
      "5": {
        "light": "#C84374",
        "dark": "#E66796",
        "role": "Cinquième pot (Hibiscus)"
      },
      "6": {
        "light": "#826E18",
        "dark": "#A89432",
        "role": "Sixième pot (Or bronze)"
      }
    },
    "illustration": {
      "outline": {
        "light": "#1C1613",
        "dark": "#F5F0EB",
        "role": "Contour de toutes les illustrations"
      },
      "green": {
        "light": "#B83B20",
        "dark": "#F07B5A",
        "role": "Billet, éléments d'action terracotta"
      },
      "mint": {
        "light": "#FCE8DF",
        "dark": "#133447",
        "role": "Grande surface d'une illustration"
      },
      "amber": {
        "light": "#FFBC38",
        "dark": "#FFBC38",
        "role": "Pièces de monnaie"
      },
      "paper": {
        "light": "#FFFFFF",
        "dark": "#1B2A3E",
        "role": "Surface neutre d'une illustration"
      }
    }
  },

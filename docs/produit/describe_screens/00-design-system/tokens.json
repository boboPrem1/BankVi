  "radius": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 28,
    "full": 9999
  },
  "elevation": {
    "e0": {
      "shadow": "aucune",
      "role": "Écrans, lignes"
    },
    "e1": {
      "shadow": "0 1 0.5 rgba(11,20,26,0.13)",
      "android": 1,
      "role": "Bulles, cartes (en clair)"
    },
    "e2": {
      "shadow": "0 2 5 rgba(11,20,26,0.16)",
      "android": 3,
      "role": "Bandeau Annuler, info-bulle"
    },
    "e3": {
      "shadow": "0 12 32 rgba(11,20,26,0.20)",
      "android": 8,
      "role": "Feuilles basses, dialogues"
    }
  },
  "motion": {
    "fast": 100,
    "standard": 200,
    "emphasized": 300,
    "easeStandard": "cubic-bezier(0.2, 0, 0, 1)",
    "easeExit": "cubic-bezier(0.3, 0, 1, 1)",
    "undoDuration": 10000
  },
